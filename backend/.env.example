# Copy to .env and adjust for your environment.
# FastAPI/uvicorn does not auto-load .env — export these or use `uvicorn --env-file .env`.

APP_NAME=AI Logistics Optimization System
APP_VERSION=2.0.0
ENVIRONMENT=development          # development | staging | production

# Comma-separated list of allowed origins for CORS. Use "*" only in development.
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true for structured JSON logs (recommended in production)

HISTORY_DAYS=120
DATA_SEED=42

MIN_FORECAST_HORIZON=3
MAX_FORECAST_HORIZON=30
REQUEST_TIMEOUT_SECONDS=30
